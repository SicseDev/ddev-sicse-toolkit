#!/usr/bin/env bash

## #ddev-generated: If you want to edit and own this file, remove this line.
## Description: Update NPM packages for the themes
## Usage: theme-update [theme-name]
## Example: ddev theme-update (updates all themes)\nddev theme-update mytheme (updates specific theme)

# Intentionally no -e: failures are accumulated per-theme and reported at the
# end so that a single bad theme does not skip the remaining ones.
set -uo pipefail

source /mnt/ddev_config/lib/common.sh

check_npm

THEME="${1:-}"
THEMES_DIR="${WEB_ROOT}/web/themes/custom"
failed_themes=()

if [ ! -d "${THEMES_DIR}" ]; then
  fail "Custom themes directory does not exist: ${THEMES_DIR}"
fi

# Update the npm packages for a single theme directory.
# Usage: update_theme /path/to/theme
update_theme() {
  local theme_dir="${1}"
  local theme_name
  theme_name=$(basename "${theme_dir}")

  echo ""
  print_section "Updating theme: ${theme_name}"

  if [ ! -f "${theme_dir}/package.json" ]; then
    print_warning "Skipping ${theme_name}: no package.json"
    return 0
  fi

  (
    cd "${theme_dir}" || { print_error "Failed to enter ${theme_dir}"; exit 1; }

    start_time=$(date +%s)

    if ! npm update; then
      print_error "npm update failed for ${theme_name}"
      exit 1
    fi

    duration=$(( $(date +%s) - start_time ))
    print_success "Updated theme: ${theme_name} in ${duration}s"
  )
}

if [ -n "${THEME}" ]; then
  if [ ! -d "${THEMES_DIR}/${THEME}" ]; then
    fail "Theme directory does not exist: ${THEMES_DIR}/${THEME}"
  fi
  update_theme "${THEMES_DIR}/${THEME}" || fail "Failed to update theme: ${THEME}"
else
  for theme_dir in "${THEMES_DIR}"/*; do
    [ -d "${theme_dir}" ] || continue
    theme_name=$(basename "${theme_dir}")
    update_theme "${theme_dir}" || failed_themes+=("${theme_name}")
  done

  echo ""
  print_separator
  if [ "${#failed_themes[@]}" -eq 0 ]; then
    print_success "All themes updated successfully"
  else
    print_error "Failed to update ${#failed_themes[@]} theme(s):"
    for failed_theme in "${failed_themes[@]}"; do
      echo -e "${RED}  - ${failed_theme}${NC}"
    done
    exit 1
  fi
fi
