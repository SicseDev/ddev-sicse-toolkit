#!/usr/bin/env bash

## #ddev-generated: If you want to edit and own this file, remove this line.
## Description: Extract translation templates from custom modules or themes
## Usage: translations-extract
## Example: ddev translations-extract --module=my_module\nddev translations-extract --module=my_module --language=en\nddev translations-extract --theme=my_theme
## Flags: [{"Name":"module","Shorthand":"m","Usage":"Name of the custom module to extract translations from","Type":"string"},{"Name":"theme","Shorthand":"t","Usage":"Name of the custom theme to extract translations from","Type":"string"},{"Name":"language","Shorthand":"l","Usage":"Language code for translation extraction","Type":"string","DefValue":"nl"}]

set -euo pipefail

source /mnt/ddev_config/sicse/lib/common.sh

POT_FILE="${WEB_ROOT}/web/general.pot"
MODULE=""
THEME=""
LANGUAGE="nl"

# Ensure temporary files are cleaned up on exit, even if the script fails.
cleanup() {
  rm -f "${POT_FILE}" 2>/dev/null || true
}
trap 'cleanup' EXIT

parse_args() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      --module=*|-m=*)  MODULE="${1#*=}";  shift ;;
      --module|-m)      MODULE="${2}";     shift 2 ;;
      --theme=*|-t=*)   THEME="${1#*=}";   shift ;;
      --theme|-t)       THEME="${2}";      shift 2 ;;
      --language=*|-l=*) LANGUAGE="${1#*=}"; shift ;;
      --language|-l)    LANGUAGE="${2}";   shift 2 ;;
      *) print_warning "Unknown argument: ${1}"; shift ;;
    esac
  done
}

validate_inputs() {
  if [ -z "${MODULE}" ] && [ -z "${THEME}" ]; then
    fail "Specify either --module=MODULE_NAME or --theme=THEME_NAME"
  fi
  if [ -n "${MODULE}" ] && [ -n "${THEME}" ]; then
    fail "Cannot specify both --module and --theme"
  fi

  if ! [[ "${LANGUAGE}" =~ ^[a-z]{2,3}(_[A-Z]{2})?$ ]]; then
    fail "Invalid language code '${LANGUAGE}'. Expected format: 'nl', 'de', 'en_US'."
  fi

  if [ -n "${MODULE}" ]; then
    EXTENSION_TYPE="Module"
    EXTENSION_NAME="${MODULE}"
    EXTENSION_ARG="--modules=${MODULE}"
    EXTENSION_DIR="${WEB_ROOT}/web/modules/custom/${MODULE}"
    TRANSLATION_FILE="${EXTENSION_DIR}/translations/${MODULE}.${LANGUAGE}.po"
  else
    EXTENSION_TYPE="Theme"
    EXTENSION_NAME="${THEME}"
    EXTENSION_ARG="--themes=${THEME}"
    EXTENSION_DIR="${WEB_ROOT}/web/themes/custom/${THEME}"
    TRANSLATION_FILE="${EXTENSION_DIR}/translations/${THEME}.${LANGUAGE}.po"
  fi

  if [ ! -d "${EXTENSION_DIR}" ]; then
    fail "${EXTENSION_TYPE} directory does not exist: ${EXTENSION_DIR}"
  fi

  local info_file="${EXTENSION_DIR}/${EXTENSION_NAME}.info.yml"
  if [ ! -f "${info_file}" ]; then
    fail "${EXTENSION_TYPE} info file does not exist: ${info_file}"
  fi
}

ensure_translations_dir() {
  mkdir -p "${EXTENSION_DIR}/translations"
}

create_htaccess() {
  local translations_dir="${1}"
  local ht_file="${translations_dir}/.htaccess"

  if [ -f "${ht_file}" ]; then
    print_success ".htaccess already exists"
    return 0
  fi

  print_warning "No .htaccess in ${translations_dir}"

  # Prefer Drupal's FileSecurity helper for a canonical result.
  if drush php:eval "
    \$directory = '${translations_dir}';
    try {
      \Drupal\Component\FileSecurity\FileSecurity::writeHtaccess(\$directory);
      echo 'OK';
    } catch (\\Throwable \$e) {
      echo 'FAILED';
    }
  " 2>/dev/null | grep -q 'OK'; then
    print_success "Created .htaccess using Drupal's FileSecurity"
    return 0
  fi

  # Fallback: write a minimal deny-all .htaccess.
  cat > "${ht_file}" <<'HT'
# Deny access to translations directory for web users.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Deny from all
</IfModule>
HT
  chmod 0644 "${ht_file}" || true

  if [ -f "${ht_file}" ]; then
    print_warning "Created fallback .htaccess — please verify its contents"
  else
    fail "Failed to create .htaccess"
  fi
}

run_extraction() {
  print_info "Rebuilding cache..."
  drush cache:rebuild

  print_info "Updating translations..."
  drush locale:check 2>/dev/null || print_warning "locale:check unavailable"
  drush locale:update 2>/dev/null || print_warning "locale:update unavailable"

  print_info "Extracting translations for language: ${LANGUAGE}..."
  if ! drush potx --api=8 --language="${LANGUAGE}" --translations "${EXTENSION_ARG}"; then
    fail "Failed to extract translations"
  fi

  if [ ! -f "${POT_FILE}" ]; then
    fail "Translation file was not generated at ${POT_FILE}"
  fi
}

move_pot_to_translation() {
  print_info "Moving translation file..."
  mv -f "${POT_FILE}" "${TRANSLATION_FILE}"
}

verify_translation_file() {
  if [ ! -s "${TRANSLATION_FILE}" ] || ! grep -q "msgid" "${TRANSLATION_FILE}"; then
    fail "Translation file appears empty or invalid: ${TRANSLATION_FILE}"
  fi

  print_success "Translation template extracted successfully"
  print_detail "Location" "${TRANSLATION_FILE}"
  print_detail "Language" "${LANGUAGE}"
  print_detail "${EXTENSION_TYPE}" "${EXTENSION_NAME}"
}

check_atd_module() {
  if is_extension_enabled "Module" "atd"; then
    return 0
  fi

  # ATD is not installed; check whether the required discovery keys are already
  # present in the extension's .info.yml.
  local info_file="${EXTENSION_DIR}/${EXTENSION_NAME}.info.yml"
  if grep -q "interface translation project:" "${info_file}" 2>/dev/null \
     && grep -q "interface translation server pattern:" "${info_file}" 2>/dev/null; then
    print_success \
      "Translation discovery keys already present in ${EXTENSION_NAME}.info.yml"
    return 0
  fi

  echo ""
  print_warning \
    "The Automatic Translation Template Discovery (ATD) module is not installed"
  echo ""
  cat <<INFO
The ATD module makes custom translations automatically discoverable by Drupal.
Without it, add the following to ${EXTENSION_NAME}.info.yml:

  interface translation project: ${EXTENSION_NAME}
  interface translation server pattern: web/${EXTENSION_TYPE,,}s/custom/${EXTENSION_NAME}/translations/%project.%language.po

More info: https://www.drupal.org/project/atd
INFO
  echo ""
  read -r -p "Press Enter to continue..."
}

main() {
  local start_time
  start_time=$(date +%s)

  parse_args "$@"
  validate_inputs

  print_header "Extracting translations for ${EXTENSION_TYPE,,} '${EXTENSION_NAME}' (${LANGUAGE})"

  check_enabled "${EXTENSION_TYPE}" "${EXTENSION_NAME}"
  ensure_translations_dir
  create_htaccess "${EXTENSION_DIR}/translations"
  run_extraction
  move_pot_to_translation
  verify_translation_file
  check_atd_module

  print_footer "Translation extraction complete" "${start_time}"
}

# Execute main() only when this script is run directly, not when it is sourced.
# When executed, BASH_SOURCE[0] equals $0; when sourced, they differ. This guard
# is what allows unit tests to source the file and call individual functions
# without triggering main().
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
