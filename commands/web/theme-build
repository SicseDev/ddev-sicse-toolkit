#!/usr/bin/env bash

## #ddev-generated: If you want to edit and own this file, remove this line.
## Description: Build theme assets (CSS/JS) using NPM
## Usage: theme-build [theme-name]
## Example: "ddev theme-build" (builds all themes)
## Example: "ddev theme-build mytheme" (builds specific theme)

# Intentionally no -e: failures are accumulated per-theme and reported at the
# end so that a single bad theme does not skip the remaining ones.
set -uo pipefail

source /mnt/ddev_config/sicse/lib/common.sh

# Build theme assets for a single theme directory. Skips silently when
# package.json is absent.
# Usage: build_theme /path/to/theme
build_theme() {
  local theme_dir="${1}"
  local theme_name
  theme_name=$(basename "${theme_dir}")

  echo ""
  print_section "Building theme: ${theme_name}"

  if [ ! -f "${theme_dir}/package.json" ]; then
    print_warning "Skipping ${theme_name}: no package.json"
    return 0
  fi

  (
    cd "${theme_dir}" || { print_error "Failed to enter ${theme_dir}"; exit 1; }

    start_time=$(date +%s)

    print_info "Running npm install in ${theme_name}..."
    if ! npm install --loglevel=error; then
      print_error "npm install failed for ${theme_name}"
      exit 1
    fi

    print_info "Running npm run build in ${theme_name}..."
    if ! npm run build --loglevel=error; then
      print_error "npm run build failed for ${theme_name}"
      exit 1
    fi

    duration=$(( $(date +%s) - start_time ))
    print_success "Finished building ${theme_name} in ${duration}s"
  )
}

main() {
  check_npm

  local themes_dir="${WEB_ROOT}/web/themes/custom"
  local theme_arg="${1:-}"

  if [ ! -d "${themes_dir}" ]; then
    fail "Custom themes directory does not exist: ${themes_dir}"
  fi

  local -a themes
  if [ -n "${theme_arg}" ]; then
    local theme_dir="${themes_dir}/${theme_arg}"
    if [ ! -d "${theme_dir}" ]; then
      fail "Theme directory does not exist: ${theme_dir}"
    fi
    themes=("${theme_dir}")
  else
    themes=()
    for d in "${themes_dir}"/*; do
      [ -d "${d}" ] || continue
      themes+=("${d}")
    done
  fi

  if [ "${#themes[@]}" -eq 0 ]; then
    fail "No themes found in ${themes_dir}"
  fi

  local -a failed_themes=()
  local theme_dir theme_name
  for theme_dir in "${themes[@]}"; do
    theme_name=$(basename "${theme_dir}")
    build_theme "${theme_dir}" || failed_themes+=("${theme_name}")
  done

  echo ""
  print_separator
  if [ "${#failed_themes[@]}" -eq 0 ]; then
    print_success "All themes built successfully"
    exit 0
  else
    print_error "Failed to build ${#failed_themes[@]} theme(s):"
    for failed_theme in "${failed_themes[@]}"; do
      echo -e "${RED}  - ${failed_theme}${NC}"
    done
    exit 1
  fi
}

# Execute main() only when this script is run directly, not when it is sourced.
# When executed, BASH_SOURCE[0] equals $0; when sourced, they differ. This guard
# is what allows unit tests to source the file and call individual functions
# without triggering main().
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
